{
	"name": "@ladbabynpm/picc-subagents",
	"version": "0.1.0",
	"description": "Claude Code style Agent tool for pi agent. Fork of tintinweb/pi-subagents, better aligned with the harness of Claude Code.",
	"author": "ladbabynpm",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ladbaby/picc-subagents.git"
	},
	"homepage": "https://github.com/ladbaby/picc-subagents#readme",
	"bugs": {
		"url": "https://github.com/ladbaby/picc-subagents/issues"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"subagent",
		"agent",
		"autonomous"
	],
	"files": [
		"src/",
		"package.json",
		"tsconfig.json",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"biome.json"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.80.0",
		"@earendil-works/pi-coding-agent": ">=0.80.0",
		"@earendil-works/pi-tui": ">=0.80.0"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.49",
		"croner": "^10.0.1",
		"nanoid": "^5.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run e2e --reporter=verbose",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/ test/",
		"lint:fix": "biome check --fix src/ test/"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@earendil-works/pi-ai": "^0.80.6",
		"@earendil-works/pi-coding-agent": "^0.80.6",
		"@earendil-works/pi-tui": "^0.80.6",
		"@types/node": "^25.5.0",
		"typescript": "^6.0.0",
		"vitest": "^4.0.18"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
